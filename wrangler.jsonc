// Cloudflare Worker（只有静态资源）：把 dist/ 发布到 https://pet-everything.stv1024.asia/
// 发布：node tools/deploy.mjs main（先构建再 wrangler deploy）。不开 workers.dev 地址。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pet-everything",
  "compatibility_date": "2026-11-20",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "pet-everything.stv1024.asia", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
